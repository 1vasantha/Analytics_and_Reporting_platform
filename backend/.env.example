# ===== Application =====
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=please-change-this-to-a-random-string-of-at-least-32-characters

# ===== CORS =====
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ===== Database =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics
POSTGRES_DB=analytics

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ===== Celery (optional - falls back to Redis db 1/2) =====
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== Rate limits (per minute, per IP) =====
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_INGESTION_PER_MINUTE=1000
RATE_LIMIT_AUTH_PER_MINUTE=5

# ===== Email (defaults to Mailhog for dev) =====
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@analytics.local
SMTP_FROM_NAME=Analytics Platform
SMTP_TLS=false

# ===== Ingestion =====
MAX_BATCH_SIZE=1000
MAX_CSV_SIZE_MB=50

# ===== Frontend URL (used in email templates) =====
FRONTEND_URL=http://localhost:3000
